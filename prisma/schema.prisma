generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  DONO
  LIDER
  COLABORADOR
}

enum EscalaTipo {
  TODOS
  DIAS_SEMANA
  DOZE_POR_TRINTA_SEIS
}

enum FrequenciaTipo {
  DIARIA
  SEMANAL
  MENSAL
  PERSONALIZADA
}

// PRODUTO = item final que sai de uma ficha técnica (o que a loja produz).
// INSUMO = matéria-prima/ingrediente que entra numa ficha técnica ou é
// consumido direto. O mesmo cadastro serve de referência pra produção,
// lojas e (futuro) estoque — todo mundo aponta pro mesmo Item, em vez de
// cada área ter seu próprio texto livre pro "mesmo" produto.
enum ItemTipo {
  PRODUTO
  INSUMO
}

model Loja {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())

  usuarios Usuario[]
  tarefas  Tarefa[]

  metasProducao MetaProducao[]
  producoes     ProducaoDiaria[]
  consumos      ConsumoRegistrado[]
}

model Usuario {
  id             String     @id @default(cuid())
  nome           String
  email          String     @unique
  senhaHash      String
  contato        String?
  papel          Papel
  ativo          Boolean    @default(true)
  createdAt      DateTime   @default(now())

  lojaId         String?
  loja           Loja?      @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  // escala (só relevante para colaborador)
  escalaTipo     EscalaTipo @default(TODOS)
  diasSemana     Int[]      @default([]) // 0=domingo .. 6=sábado
  escalaDataBase DateTime?  @db.Date

  tarefasAtribuidas TarefaAtribuicao[]
  instancias        TarefaInstancia[]
  sessoes           Sessao[]

  metasProducaoCriadas MetaProducao[]      @relation("MetasCriadas")
  producoesRegistradas ProducaoDiaria[]    @relation("ProducoesRegistradas")
  consumosRegistrados  ConsumoRegistrado[] @relation("ConsumosRegistrados")

  @@index([lojaId])
}

model Tarefa {
  id              String         @id @default(cuid())
  lojaId          String
  loja            Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  titulo          String
  descricao       String?
  categoria       String?        // texto livre: "Abertura", "Fechamento", "Rotina", "Caixa", etc.
  requerFoto      Boolean        @default(false)
  link            String?        // se preenchido, a tarefa não pede foto: colaborador abre o link e depois marca como feita
  ativo           Boolean        @default(true)
  createdAt       DateTime       @default(now())

  frequenciaTipo    FrequenciaTipo
  diasSemana        Int[]          @default([]) // usado quando SEMANAL
  diaDoMes          Int?           // usado quando MENSAL
  datasEspecificas  DateTime[]     @default([]) @db.Date // usado quando PERSONALIZADA

  horarioInicio   String?        // "HH:MM", opcional
  horarioFim      String?        // "HH:MM" — depois desse horário a tarefa do dia vira atrasada

  atribuidoATodos Boolean        @default(true)
  atribuicoes     TarefaAtribuicao[]
  instancias      TarefaInstancia[]

  @@index([lojaId])
}

model TarefaAtribuicao {
  id        String   @id @default(cuid())
  tarefaId  String
  tarefa    Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tarefaId, usuarioId])
}

// Só existe um registro quando a tarefa foi concluída naquele dia por aquela pessoa.
// Pendência = existe expectativa (escala + recorrência) mas não existe instância.
model TarefaInstancia {
  id             String   @id @default(cuid())
  tarefaId       String
  tarefa         Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  data           DateTime @db.Date
  tituloSnapshot String
  fotoPath       String?
  concluidoEm    DateTime @default(now())

  @@unique([tarefaId, usuarioId, data])
  @@index([usuarioId, data])
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// Cadastro central de produtos e insumos — a "ficha técnica" de cada produto
// é a lista de insumos (e quantidade de cada um) necessária pra produzir 1
// unidade dele. Não é por loja: é o mesmo catálogo pra toda a rede.
model Item {
  id        String   @id @default(cuid())
  nome      String
  tipo      ItemTipo
  unidade   String // texto livre: "kg", "g", "L", "ml", "un", "cx"...
  codigo    String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  ingredientes  FichaTecnicaItem[] @relation("Ingredientes") // quando tipo = PRODUTO: os insumos da sua ficha técnica
  usadoEmFichas FichaTecnicaItem[] @relation("UsadoComoInsumo") // quando tipo = INSUMO: em quais fichas técnicas ele entra

  metasProducao MetaProducao[] // quando tipo = PRODUTO
  producoes     ProducaoDiaria[] // quando tipo = PRODUTO
  consumos      ConsumoRegistrado[] // quando tipo = INSUMO

  @@index([tipo])
}

// Uma linha da ficha técnica: "pra produzir 1 unidade do produto X, gasta
// quantidadePorUnidade do insumo Y".
model FichaTecnicaItem {
  id                   String @id @default(cuid())
  produtoId            String
  produto              Item   @relation("Ingredientes", fields: [produtoId], references: [id], onDelete: Cascade)
  insumoId             String
  insumo               Item   @relation("UsadoComoInsumo", fields: [insumoId], references: [id], onDelete: Cascade)
  quantidadePorUnidade Float

  @@unique([produtoId, insumoId])
  @@index([insumoId])
}

// Meta/planejamento de produção do dia: quanto se espera produzir daquele
// produto, naquela loja, naquela data. Um valor só por loja+produto+dia.
model MetaProducao {
  id          String   @id @default(cuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produtoId   String
  produto     Item     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  data        DateTime @db.Date
  quantidade  Float
  criadoPorId String
  criadoPor   Usuario  @relation("MetasCriadas", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([lojaId, produtoId, data])
}

// Registro real de produção — pode ter mais de um lançamento no mesmo dia
// (ex: um lote de manhã, outro à tarde). A soma do dia é a "quantidade real
// produzida" usada nos comparativos.
model ProducaoDiaria {
  id              String   @id @default(cuid())
  lojaId          String
  loja            Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produtoId       String
  produto         Item     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  data            DateTime @db.Date
  quantidade      Float
  observacao      String?
  registradoPorId String
  registradoPor   Usuario  @relation("ProducoesRegistradas", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@index([lojaId, produtoId, data])
}

// Consumo real de insumo, lançado manualmente (ex: contagem de estoque, saída
// de almoxarifado) — comparado contra o consumo esperado calculado a partir
// da ficha técnica × produção real do período.
model ConsumoRegistrado {
  id              String   @id @default(cuid())
  lojaId          String
  loja            Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  insumoId        String
  insumo          Item     @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  data            DateTime @db.Date
  quantidade      Float
  observacao      String?
  registradoPorId String
  registradoPor   Usuario  @relation("ConsumosRegistrados", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@index([lojaId, insumoId, data])
}
