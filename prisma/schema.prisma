generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  DONO
  LIDER
  COLABORADOR
}

enum EscalaTipo {
  TODOS
  DIAS_SEMANA
  DOZE_POR_TRINTA_SEIS
}

enum FrequenciaTipo {
  DIARIA
  SEMANAL
  MENSAL
  PERSONALIZADA
}

// Marca uma tarefa como o gatilho de abertura/fechamento do caixa da loja: ao concluir
// essa tarefa específica, o colaborador preenche o formulário do caixa (em vez do simples
// "marcar como feito"), e completar o formulário conclui a tarefa automaticamente.
enum TarefaTipoEspecial {
  NORMAL
  ABERTURA_CAIXA
  FECHAMENTO_CAIXA
}

enum CaixaStatus {
  ABERTO
  FECHADO
}

enum CaixaMovimentoTipo {
  ENTRADA
  SAIDA
}

model Loja {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())

  usuarios Usuario[]
  tarefas  Tarefa[]
  caixas   Caixa[]
}

model Usuario {
  id             String     @id @default(cuid())
  nome           String
  email          String     @unique
  senhaHash      String
  contato        String?
  papel          Papel
  ativo          Boolean    @default(true)
  createdAt      DateTime   @default(now())

  lojaId         String?
  loja           Loja?      @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  // escala (só relevante para colaborador)
  escalaTipo     EscalaTipo @default(TODOS)
  diasSemana     Int[]      @default([]) // 0=domingo .. 6=sábado
  escalaDataBase DateTime?  @db.Date

  tarefasAtribuidas TarefaAtribuicao[]
  instancias        TarefaInstancia[]
  sessoes           Sessao[]

  caixasAbertos        Caixa[]          @relation("CaixaAbertoPor")
  caixasFechados       Caixa[]          @relation("CaixaFechadoPor")
  caixasVendaInformada Caixa[]          @relation("CaixaVendaInformadaPor")
  caixaMovimentos      CaixaMovimento[]

  @@index([lojaId])
}

model Tarefa {
  id              String         @id @default(cuid())
  lojaId          String
  loja            Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  titulo          String
  descricao       String?
  requerFoto      Boolean        @default(false)
  ativo           Boolean        @default(true)
  createdAt       DateTime       @default(now())

  frequenciaTipo    FrequenciaTipo
  diasSemana        Int[]          @default([]) // usado quando SEMANAL
  diaDoMes          Int?           // usado quando MENSAL
  datasEspecificas  DateTime[]     @default([]) @db.Date // usado quando PERSONALIZADA

  horarioInicio   String?        // "HH:MM", opcional
  horarioFim      String?        // "HH:MM" — depois desse horário a tarefa do dia vira atrasada

  tipoEspecial    TarefaTipoEspecial @default(NORMAL)

  atribuidoATodos Boolean        @default(true)
  atribuicoes     TarefaAtribuicao[]
  instancias      TarefaInstancia[]

  @@index([lojaId])
}

model TarefaAtribuicao {
  id        String   @id @default(cuid())
  tarefaId  String
  tarefa    Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tarefaId, usuarioId])
}

// Só existe um registro quando a tarefa foi concluída naquele dia por aquela pessoa.
// Pendência = existe expectativa (escala + recorrência) mas não existe instância.
model TarefaInstancia {
  id             String   @id @default(cuid())
  tarefaId       String
  tarefa         Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  data           DateTime @db.Date
  tituloSnapshot String
  fotoPath       String?
  concluidoEm    DateTime @default(now())

  @@unique([tarefaId, usuarioId, data])
  @@index([usuarioId, data])
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// Uma sessão de caixa de uma loja: aberta por alguém (colaborador ou líder), que é a
// única pessoa autorizada a lançar entradas/saídas e fechar esse caixa. Só pode haver
// um caixa ABERTO por loja por vez — a abertura do próximo depende do fechamento deste.
model Caixa {
  id     String      @id @default(cuid())
  lojaId String
  loja   Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  status CaixaStatus @default(ABERTO)

  abertoPorId   String
  abertoPor     Usuario  @relation("CaixaAbertoPor", fields: [abertoPorId], references: [id])
  abertoEm      DateTime @default(now())
  valorAbertura Decimal  @db.Decimal(10, 2)
  obsAbertura   String?

  fechadoPorId  String?
  fechadoPor    Usuario?  @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id])
  fechadoEm     DateTime?
  // O que o colaborador contou no caixa — ele nunca vê o valor esperado antes de digitar
  // isso, de propósito, pra contar de verdade em vez de repetir um número que já viu.
  valorContado  Decimal?  @db.Decimal(10, 2)
  // Snapshot calculado no fechamento: abertura + entradas - saídas (só reforços de troco e
  // retiradas — vendas não são lançadas como movimento). Visível só pra dono/líder.
  valorEsperado Decimal?  @db.Decimal(10, 2)
  // Estimativa de venda em dinheiro IMPLÍCITA no que foi contado: valorContado - valorEsperado.
  // Enquanto não há integração com um sistema de vendas de verdade, é só um número derivado
  // da contagem física — a conferência real acontece quando o dono informa vendaInformada.
  vendaEstimada Decimal?  @db.Decimal(10, 2)
  obsFechamento String?
  // true quando o dono/líder precisou fechar no lugar de quem abriu (ausência, esquecimento etc).
  fechamentoForcado Boolean @default(false)

  // Preenchido depois, à mão, pelo dono/líder — quanto o sistema de vendas (externo, ainda
  // sem integração) diz que foi vendido em dinheiro naquele caixa. Comparado com
  // vendaEstimada pra saber se bateu.
  vendaInformada      Decimal?  @db.Decimal(10, 2)
  vendaInformadaPorId String?
  vendaInformadaPor   Usuario?  @relation("CaixaVendaInformadaPor", fields: [vendaInformadaPorId], references: [id])
  vendaInformadaEm    DateTime?

  movimentos CaixaMovimento[]

  @@index([lojaId, status])
}

model CaixaMovimento {
  id      String @id @default(cuid())
  caixaId String
  caixa   Caixa  @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  tipo       CaixaMovimentoTipo
  usuarioId  String
  usuario    Usuario            @relation(fields: [usuarioId], references: [id])
  valor      Decimal            @db.Decimal(10, 2)
  observacao String?
  criadoEm   DateTime           @default(now())

  @@index([caixaId])
}
